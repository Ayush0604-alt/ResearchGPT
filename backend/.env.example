# ============================================================
# ResearchGPT Backend — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- Application ---
APP_NAME=ResearchGPT
# Any value other than 'development' requires a strong SECRET_KEY
APP_ENV=development
DEBUG=true
SQL_ECHO=false
API_V1_PREFIX=/api

# --- Security ---
# Generate with: openssl rand -hex 32
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# --- Database ---
DATABASE_URL=
# For sync (alembic): use postgresql+psycopg://...
SYNC_DATABASE_URL=
GEMINI_MODEL=gemini-2.5-flash

# --- Paper collection (PDFs are read in memory, never stored) ---
MAX_PDF_SIZE_MB=25

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Rate Limiting ---
MAX_PAPERS_PER_SEARCH=20
MAX_PAPERS_TO_DOWNLOAD=10
