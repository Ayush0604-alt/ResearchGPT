# ============================================================
# ResearchGPT Backend — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- Application ---
APP_NAME=ResearchGPT
# Any value other than 'development' requires a strong SECRET_KEY
APP_ENV=development
DEBUG=true
SQL_ECHO=false
API_V1_PREFIX=/api

# --- Security ---
# Generate with: openssl rand -hex 32
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Session cookies over HTTPS only. Must be true outside development.
COOKIE_SECURE=false
ALGORITHM=HS256

# --- Database ---
DATABASE_URL=
# For sync (alembic): use postgresql+psycopg://...
SYNC_DATABASE_URL=

# --- Paper collection (PDFs are read in memory, never stored) ---
MAX_PDF_SIZE_MB=25

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Abuse limits ---
RATE_LIMIT_ENABLED=true
# memory:// counts per instance; use redis://host:6379 to share across instances
RATE_LIMIT_STORAGE_URI=memory://
MAX_PROJECTS_PER_DAY=20
# Trusted reverse proxy for X-Forwarded-For (read by uvicorn)
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Paper search limits ---
MAX_PAPERS_PER_SEARCH=20
MAX_PAPERS_TO_DOWNLOAD=10
