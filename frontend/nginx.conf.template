# Rendered at container start by nginx's envsubst: ${API_UPSTREAM} is the API
# base URL (default http://backend:8000, set in the Dockerfile).
server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # ── Security headers ─────────────────────────────────────────────────────
    # Keep in sync with public/_headers (static hosts); a unit test checks it.
    # Users' LLM keys live in localStorage, so any injected script could steal
    # them: scripts only from this origin, no inline scripts, no third-party
    # hosts. 'unsafe-inline' in style-src is for react-hot-toast's runtime
    # <style> tag; styles can't read localStorage. connect-src lists every LLM
    # provider the browser may call with the user's key. HSTS only takes effect
    # over HTTPS (TLS is terminated in front of this container).
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://generativelanguage.googleapis.com https://api.anthropic.com https://api.openai.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;

    # Proxy API to backend
    location /api/ {
        proxy_pass         ${API_UPSTREAM};
        proxy_http_version 1.1;

        # Host is the upstream's own name, not this site's. A platform that
        # routes by Host (Render does, for *.onrender.com and custom domains)
        # cannot route the request otherwise. $proxy_host is taken from
        # proxy_pass, so it stays correct for a container name, an internal
        # address or a public URL without another variable to keep in sync.
        proxy_set_header   Host $proxy_host;
        # Send SNI when the upstream is https, or its TLS handshake fails.
        proxy_ssl_server_name on;
        # Rewrite any absolute redirect the API returns back to this origin,
        # so the upstream's hostname never reaches the browser.
        proxy_redirect     default;

        # The API is behind two hops here; it reads the client IP from
        # X-Forwarded-For for rate limiting, and the scheme for its own URLs.
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   X-Forwarded-Host $host;
    }

    # React SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml;
}
